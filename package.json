{
  "name": "homebridge-grafana-exporter",
  "version": "1.0.0",
  "displayName": "Homebridge Grafana Exporter",
  "description": "Homebridge plugin to export accessory data (temperature, humidity) to Grafana-compatible data sources (InfluxDB, Graphite, PostgreSQL).",
  "author": "Luke Zbihlyj",
  "maintainers": [
    "lukezbihlyj"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukezbihlyj/homebridge-grafana-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/lukezbihlyj/homebridge-grafana-exporter/issues"
  },
  "homepage": "https://github.com/lukezbihlyj/homebridge-grafana-exporter#readme",
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.6.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "grafana",
    "influxdb",
    "graphite",
    "postgresql",
    "thermostat",
    "exporter",
    "metrics",
    "homekit"
  ],
  "dependencies": {
    "@homebridge/hap-client": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.1",
    "homebridge": "^1.6.0",
    "nodemon": "^2.0.20",
    "rimraf": "^3.0.2",
    "ts-node": "^10.3.0",
    "typescript": "^5.0.0"
  }
}
